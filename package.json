{
  "name": "amaravati-travel",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "preview": "serve out -l 3000",
    "check:planner": "node scripts/check-planner.mjs",
    "check:export": "node scripts/check-export.mjs",
    "check:deals": "node scripts/check-weekly-deals.mjs",
    "format": "prettier --write src scripts public *.json *.ts *.mjs README.md"
  },
  "dependencies": {
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.7",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
